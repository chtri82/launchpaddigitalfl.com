# INACTIVE TEMPLATE. To enable after Charlie approves: copy to .github/workflows/update-news.yml in the repo.
name: Update news headlines
on:
  schedule:
    - cron: "17 */2 * * *"   # about every 2 hours (GitHub may delay scheduled runs)
  workflow_dispatch: {}
permissions:
  contents: write
concurrency:
  group: update-news
jobs:
  fetch:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install feedparser==6.0.11 requests==2.32.3
      - run: python _news-tools/fetch_news.py
      - name: Commit if headlines changed
        run: |
          git config user.name "launchpad-news-bot"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add news/data
          git diff --cached --quiet || git commit -m "Update news headlines"
          git push
